{ config, lib, ... }:
let
  # Match the unit names generated by Home Manager's native rclone module.
  unitPath = builtins.replaceStrings [ "/" " " "$" ] [ "." "_" "" ];
  mountsFor =
    remotes:
    lib.concatMap (
      remoteName:
      lib.mapAttrsToList (path: mount: {
        inherit (mount) mountPoint;
        unit = "rclone-mount:${unitPath path}@${remoteName}";
      }) (lib.filterAttrs (_: mount: mount.enable) remotes.${remoteName}.mounts)
    ) (lib.attrNames remotes);
  userMounts = lib.mapAttrs (
    _: home: if home.programs.rclone.enable then mountsFor home.programs.rclone.remotes else [ ]
  ) config.home-manager.users;
  mountPoints = lib.concatMap (mounts: map (mount: mount.mountPoint) mounts) (
    lib.attrValues userMounts
  );
in
{
  assertions = [
    {
      assertion = lib.length mountPoints == lib.length (lib.unique mountPoints);
      message = "Home Manager rclone mounts must have distinct mountpoints across users and remotes.";
    }
    {
      assertion = lib.all (path: !(builtins.hasAttr path config.fileSystems)) mountPoints;
      message = "Home Manager rclone mountpoints must not overlap NixOS fileSystems.";
    }
  ];

  programs.fuse.userAllowOther = lib.mkIf (mountPoints != [ ]) true;
  users.users = lib.mapAttrs (_: _: { linger = true; }) (
    lib.filterAttrs (_: mounts: mounts != [ ]) userMounts
  );

  # Persistent directories, with no age-based cleanup. Never recursively chown
  # these paths: when mounted, they expose remote objects rather than local files.
  systemd.tmpfiles.settings."10-rclone-mounts" = lib.listToAttrs (
    lib.concatMap (
      user:
      map (mount: {
        name = mount.mountPoint;
        value.d = {
          mode = "0770";
          inherit user;
          group = config.users.users.${user}.group;
        };
      }) userMounts.${user}
    ) (lib.attrNames userMounts)
  );

  home-manager.sharedModules = [
    ({ config, ... }: {
      systemd.user.services = lib.mkIf config.programs.rclone.enable (
        lib.listToAttrs (
          map (
            mount:
            lib.nameValuePair mount.unit {
              Unit = {
                StartLimitIntervalSec = 0;
                # Avoid default.target's implicit After= ordering on this
                # Type=notify service. Restore normal start/shutdown ordering
                # explicitly because DefaultDependencies also controls those.
                DefaultDependencies = false;
                After = [ "basic.target" ];
                Before = [ "shutdown.target" ];
                Conflicts = [ "shutdown.target" ];
              };
              Service = {
                # Home Manager supplies Type=notify and Restart=on-failure.
                RestartSec = "15s";
                TimeoutStartSec = "90s";
                TimeoutStartFailureMode = "kill";
                # Do not wait for remote uploads when a node is shutting down.
                # TimeoutStopSec bounds each stop phase, not the whole reboot.
                TimeoutStopSec = "10s";
                TimeoutStopFailureMode = "kill";
                KillMode = "control-group";
                SendSIGKILL = true;
                FinalKillSignal = "SIGKILL";
                # Detach locally even with open files or an unreachable backend.
                ExecStop = "-/run/wrappers/bin/fusermount3 -uz ${lib.escapeShellArg mount.mountPoint}";
                ExecStopPost = "-/run/wrappers/bin/fusermount3 -uz ${lib.escapeShellArg mount.mountPoint}";
              };
            }
          ) (mountsFor config.programs.rclone.remotes)
        )
      );
    })
  ];
}
